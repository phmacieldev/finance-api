# ── Banco de dados ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/financeiro
DB_USER=admin
DB_PASS=secret

# ── JWT ─────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 64   (ou qualquer string com 48+ chars)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-aqui-minimo-48-chars
JWT_EXPIRATION=86400000

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── URL pública do frontend (usada nos links de email) ──────────
APP_URL=http://localhost:3000

# ── SMTP (deixar SMTP_HOST em branco para apenas logar no console) ──
# Gmail (App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu@gmail.com
#   SMTP_PASS=sua-app-password-de-16-chars
#
# Mailtrap (testes):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=<user do mailtrap>
#   SMTP_PASS=<senha do mailtrap>
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.sua-api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Endereço remetente dos emails (ex: noreply@seudominio.com)
# Para Resend: use um endereço do domínio verificado no painel do Resend
MAIL_FROM=
# SMTP_AUTH e SMTP_TLS já têm default true; só mude se o provedor exigir
# SMTP_AUTH=true
# SMTP_TLS=true

# ── Admin da plataforma (criado no primeiro boot) ────────────────
PLATFORM_ADMIN_EMAIL=admin@plataforma.com
PLATFORM_ADMIN_PASSWORD=admin@1234
